// =============================================================================================
// Controles sobre compras públicas del Perú: medidas DAX equivalentes al proceso en Python y SQL.
// Modelo: ver powerbi/MODEL.md. Cargue los CSV de outputs/powerbi/ (los crea `make pipeline`).
//
// Señales, nunca acusaciones: una alerta significa «merece revisión», no «hay una irregularidad».
// No arme visuales que ordenen proveedores, funcionarios ni personas con nombre propio. Muestre
// las entidades públicas solo en visuales agregados (por tipo, segmento, método o mes).
// =============================================================================================

// ---- Volúmenes -------------------------------------------------------------------------------
Procesos = DISTINCTCOUNT ( fact_process[ocid] )

Procesos competitivos =
CALCULATE ( [Procesos], fact_process[is_competitive] = TRUE () )

Monto adjudicado (S/) = SUM ( fact_process[award_amount] )

// ---- Alertas ---------------------------------------------------------------------------------
Alertas = COUNTROWS ( fact_alert )

Procesos con alerta = DISTINCTCOUNT ( fact_alert[ocid] )

% Procesos con alerta = DIVIDE ( [Procesos con alerta], [Procesos] )

Alertas por cada 100 procesos = DIVIDE ( [Alertas], [Procesos] ) * 100

Procesos prioridad P1 =
CALCULATE ( DISTINCTCOUNT ( fact_risk_score[ocid] ), fact_risk_score[priority] = "P1" )

Puntaje promedio (con alerta) = AVERAGE ( fact_risk_score[score] )

// Recalcula el puntaje «noisy-OR» desde las alertas, para que un filtro sobre dim_control
// (por ejemplo «sin C02») muestre cómo quedaría el puntaje con un subconjunto de controles.
// puntaje = 100 × (1 − PRODUCTO por control (1 − máx(peso × severidad)))
Puntaje recalculado =
VAR PorControl =
    ADDCOLUMNS (
        SUMMARIZE ( fact_alert, fact_alert[ocid], fact_alert[control_id] ),
        "@ps", CALCULATE ( MAX ( fact_alert[weighted_severity] ) )
    )
VAR PorProceso =
    ADDCOLUMNS (
        VALUES ( fact_alert[ocid] ),
        "@puntaje",
            100 * ( 1 - PRODUCTX ( FILTER ( PorControl, fact_alert[ocid] = EARLIER ( fact_alert[ocid] ) ), 1 - [@ps] ) )
    )
RETURN
    AVERAGEX ( PorProceso, [@puntaje] )

// ---- Medidas por señal -----------------------------------------------------------------------
// Un solo postor: proporción de procesos competitivos con un solo postor
Tasa de postor único =
DIVIDE (
    CALCULATE ( [Procesos], fact_process[is_competitive] = TRUE (), fact_process[n_tenderers] = 1 ),
    [Procesos competitivos]
)

// Tasa de postor único de la entidad o método actual frente a la nacional del mismo método.
// (La usa el protocolo de revisión: «un solo postor» se revisa sola solo si esto es mayor a 1.)
Postor único frente al país =
VAR Local = [Tasa de postor único]
VAR Nacional =
    CALCULATE ( [Tasa de postor único], REMOVEFILTERS ( dim_entity ) )
RETURN
    DIVIDE ( Local, Nacional )

// Concentración: índice de Herfindahl-Hirschman sobre el monto adjudicado en el contexto actual
// (úselo con tipo de entidad × segmento × año en filas; nunca con proveedores en filas).
Índice de concentración (HHI) =
VAR Total = [Monto adjudicado (S/)]
RETURN
    IF (
        Total > 0,
        10000
            * SUMX (
                VALUES ( fact_process[supplier_key] ),
                DIVIDE ( CALCULATE ( [Monto adjudicado (S/)] ), Total ) ^ 2
            )
    )

Altamente concentrado (1 = sí) = IF ( [Índice de concentración (HHI)] > 2500, 1, 0 )    // thresholds.yaml: hhi_highly_concentrated

// Contratos que crecen: aumento acumulado de los contratos modificados
Contratos modificados =
CALCULATE ( COUNTROWS ( fact_contract ), NOT ISBLANK ( fact_contract[final_amount] ) )

Aumento promedio por adendas % =
AVERAGEX (
    FILTER ( fact_contract, NOT ISBLANK ( fact_contract[final_amount] ) && fact_contract[original_amount] > 0 ),
    fact_contract[final_amount] / fact_contract[original_amount] - 1
)

// Demora en la firma
Días hasta la firma (mediana) = MEDIAN ( fact_contract[days_award_to_signature] )

// Benford (solo agregado)
Desviación Benford (todas las adjudicaciones) =
CALCULATE ( MAX ( fact_benford[mad] ), fact_benford[scope_type] = "all" )

Entidades fuera de lo esperable por azar =
CALCULATE ( COUNTROWS ( fact_benford ), fact_benford[scope_type] = "buyer", fact_benford[flag] = TRUE () )

// ---- Calidad del dato ------------------------------------------------------------------------
Problemas de datos críticos = CALCULATE ( COUNTROWS ( fact_dq_issue ), fact_dq_issue[severity] = "critical" )

Problemas de datos menores = CALCULATE ( COUNTROWS ( fact_dq_issue ), fact_dq_issue[severity] = "warning" )

// ---- Tiempo ----------------------------------------------------------------------------------
% Con alerta año anterior =
CALCULATE ( [% Procesos con alerta], SAMEPERIODLASTYEAR ( dim_date[date] ) )

Cambio frente al año anterior (puntos) = ( [% Procesos con alerta] - [% Con alerta año anterior] ) * 100

// ---- Tarjeta de aviso ------------------------------------------------------------------------
Aviso =
"Señales, nunca acusaciones: una alerta significa que el caso merece revisión, no que haya una irregularidad."
